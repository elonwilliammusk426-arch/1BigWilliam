# Add the keys for all owner-controlled Telnyx accounts.
TELNYX_API_KEYS=
TELNYX_API_KEY=
TELNYX_EXTRA_API_KEYS=
TELNYX_BASE_URL=https://api.telnyx.com/v2
TELNYX_FROM_NUMBER=
TELNYX_NUMBERS=

# A configured public key enables verification immediately. Include a key for
# every account, test their webhooks, then set REQUIRE_SIGNATURE=true to reject
# requests even if the keys are accidentally removed. Blank/false is legacy,
# unauthenticated mode and is NOT recommended in production.
TELNYX_PUBLIC_KEYS=
TELNYX_PUBLIC_KEY=
TELNYX_EXTRA_PUBLIC_KEYS=
TELNYX_SIGNATURE_TOLERANCE=300
TELNYX_REQUIRE_SIGNATURE=false

# Sync/display/retention window. Messages and pending alerts older than this
# many hours are removed. Allowed range: 1–720.
TELNYX_SYNC_LOOKBACK_HOURS=48
# Optional date range override; otherwise enough days to cover the window.
TELNYX_SYNC_DATE_RANGE=
# Polling is a fallback, not a substitute for a working Telnyx webhook.
TELNYX_POLLING_ENABLED=true
TELNYX_POLL_INTERVAL_SECONDS=60
# Newest records per account, up to 500 and at most 10 API pages.
TELNYX_POLL_LIMIT=20

TELEGRAM_BOT_TOKEN=
OWNER_TELEGRAM_ID=
# Optional; falls back to the owner's private chat when blank.
TELEGRAM_ALERT_CHAT_ID=
# Random 1–256 ASCII letters/digits/underscores/hyphens. Register the same
# secret with Telegram using set_telegram_webhook.py. Blank means unauthenticated.
TELEGRAM_WEBHOOK_SECRET=
# After registering the secret, reject requests if it is accidentally removed.
TELEGRAM_REQUIRE_SECRET=false
# Extra numeric chat IDs where owner-only commands are permitted (CSV).
# Owner's private chat and numeric TELEGRAM_ALERT_CHAT_ID are always permitted.
TELEGRAM_COMMAND_CHAT_IDS=

# Optional SQLite path. On Railway attach a volume at /data first, then migrate
# any existing DB safely before setting INBOUND_DB_PATH=/data/inbound.db.
# INBOUND_DB_PATH=inbound.db

PUBLIC_BASE_URL=https://your-app.up.railway.app
