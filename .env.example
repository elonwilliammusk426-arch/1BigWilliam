# ---------------------------------------------------------------------------
# Copy this file to ".env" and fill in your real values.
# Provider: Telnyx Messaging API
# ---------------------------------------------------------------------------

# Telnyx API key from Telnyx Portal -> API Keys
TELNYX_API_KEY=KEYxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TELNYX_BASE_URL=https://api.telnyx.com/v2

# Your SMS-enabled Telnyx number in E.164 format. You can also pass --from.
TELNYX_FROM_NUMBER=+12015550123

# Telnyx public key for webhook signature verification.
# Strongly recommended in production. Leave blank only for local testing.
TELNYX_PUBLIC_KEY=
TELNYX_SIGNATURE_TOLERANCE=300

# OTP settings
OTP_LENGTH=6
OTP_TTL_SECONDS=300

# ---------------------------------------------------------------------------
# Telegram inbox (owner-only) — receives alerts + /recent, /numbers commands
# ---------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=123456789:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Your personal Telegram user id. Used to lock bot commands to you only.
OWNER_TELEGRAM_ID=000000000

# Where inbound SMS alerts should drop. Use your private group chat id here.
# Telegram private/supergroup IDs are usually negative, e.g. -1001234567890.
# If blank, alerts go to OWNER_TELEGRAM_ID.
TELEGRAM_ALERT_CHAT_ID=
