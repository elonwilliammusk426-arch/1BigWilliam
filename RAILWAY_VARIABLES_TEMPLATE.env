# Railway Variables Template — 1BigWilliam SMS Inbox
# Copy these into Railway → Project → Service → Variables.
# Replace the demo values with your real Telnyx/Telegram/Numverify values.

# ---------------------------------------------------------------------------
# Telnyx account keys
# ---------------------------------------------------------------------------
# Put your main/first Telnyx account API key here.
TELNYX_API_KEY=KEY_ACCOUNT_01_REPLACE_ME

# Put every additional Telnyx account API key here, separated by commas.
# No spaces after commas.
# Example with 4 accounts total:
# TELNYX_EXTRA_API_KEYS=KEY_ACCOUNT_02_REPLACE_ME,KEY_ACCOUNT_03_REPLACE_ME,KEY_ACCOUNT_04_REPLACE_ME
TELNYX_EXTRA_API_KEYS=KEY_ACCOUNT_02_REPLACE_ME,KEY_ACCOUNT_03_REPLACE_ME,KEY_ACCOUNT_04_REPLACE_ME,KEY_ACCOUNT_05_REPLACE_ME,KEY_ACCOUNT_06_REPLACE_ME,KEY_ACCOUNT_07_REPLACE_ME,KEY_ACCOUNT_08_REPLACE_ME,KEY_ACCOUNT_09_REPLACE_ME,KEY_ACCOUNT_10_REPLACE_ME

TELNYX_BASE_URL=https://api.telnyx.com/v2

# ---------------------------------------------------------------------------
# Telnyx numbers
# ---------------------------------------------------------------------------
# Default sender number. This can be your first/main Telnyx number.
TELNYX_FROM_NUMBER=+1MAINNUMBER

# List all Telnyx numbers you want the bot to display/check.
# These numbers can come from different Telnyx accounts.
# No spaces after commas.
TELNYX_NUMBERS=+1MAINNUMBER,+1ACCOUNT2NUMBER,+1ACCOUNT3NUMBER,+1ACCOUNT4NUMBER,+1ACCOUNT5NUMBER,+1ACCOUNT6NUMBER,+1ACCOUNT7NUMBER,+1ACCOUNT8NUMBER,+1ACCOUNT9NUMBER,+1ACCOUNT10NUMBER

# ---------------------------------------------------------------------------
# Telnyx webhook public keys — optional during testing
# ---------------------------------------------------------------------------
# Public keys verify that incoming webhook POSTs really came from Telnyx.
# For easier setup with many accounts, you may leave these blank and rely on
# API-key polling/sync. Add public keys later for stronger security.
TELNYX_PUBLIC_KEY=
TELNYX_EXTRA_PUBLIC_KEYS=
TELNYX_SIGNATURE_TOLERANCE=300

# ---------------------------------------------------------------------------
# Fallback polling/sync
# ---------------------------------------------------------------------------
# Keep this enabled so Railway polls all Telnyx accounts for missed SMS.
TELNYX_POLLING_ENABLED=true
TELNYX_POLL_INTERVAL_SECONDS=60
TELNYX_POLL_LIMIT=20

# Leave blank. This lets sync pull recent records across UTC date boundaries.
TELNYX_SYNC_DATE_RANGE=

# ---------------------------------------------------------------------------
# Numverify /checknum command
# ---------------------------------------------------------------------------
NUMVERIFY_API_KEY=NUMVERIFY_KEY_REPLACE_ME
NUMVERIFY_BASE_URL=https://apilayer.net/api/validate

# ---------------------------------------------------------------------------
# OTP settings for codes generated by this toolkit only
# Does not affect incoming OTP SMS from other services.
# ---------------------------------------------------------------------------
OTP_LENGTH=6
OTP_TTL_SECONDS=300

# ---------------------------------------------------------------------------
# Telegram bot/group
# ---------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=TELEGRAM_BOT_TOKEN_REPLACE_ME
OWNER_TELEGRAM_ID=8355280769
TELEGRAM_ALERT_CHAT_ID=-1004447057144
